# Groq API key (get for free from console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Qdrant URL (use 'local' for on-disk or set a cloud endpoint)
QDRANT_URL=local
QDRANT_API_KEY=

# Supabase / SQLite configuration
SUPABASE_URL=mock
SUPABASE_KEY=mock

# CORS Allowed Origins (comma-separated domains, e.g. http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
